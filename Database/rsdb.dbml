Table users {
    id uuid [pk, default: `gen_random_uuid()`]
    num_buy int [not null, default: 0]
    avg_spent int [not null, default: 0]
}

Table categories {
    id int [pk, increment]
    name text [not null]
}
Table meals {
    id int [pk, increment]
    cat_id int [not null]
    name text [not null]
    num_sold int [not null, default: 0]
    price numeric [not null]
    available bool [default: true]
    is_hotsell bool [default: false]
    is_bestsell bool [default: false]
    is_seasonal bool [default: false]
    is_combo bool [default: false]
}
Table meals_item{
    id int [pk, increment]
    meal_id int [not null]
    item_id int [not null]
    quantity int [default : 1]
    group_id int [null]
    indexes {
        (meal_id, item_id, group_id) [unique]
    }
}
Table items{
    id int [pk, increment]
    name text [not null]
}
Table option_groups{
    id int [pk, increment]
    meal_id int [not null]
    name text [not null]
    min_choices int [default: 1]
    max_choices int [default: 1]
}
Table cart_items {
  id int [pk, increment]
  user_id uuid [not null]     
  meal_id int [not null]  
  quantity int [default: 1]  
  indexes {
    (user_id, meal_id) [unique]
  }
}
Table history {
    user_id uuid [not null]
    meal_id int [not null]
    times_order int [default: 1]
    day_buy TIMESTAMP [not null]
    indexes {
        (user_id, meal_id) [pk]
    }
}
Table user_fav_cat {
  user_id uuid [not null]
  cat_id int [not null]
  indexes {
    (user_id, cat_id) [pk] 
  }
}
Table user_fav_meal {
  user_id uuid [not null]
  meal_id int [not null]
  indexes {
    (user_id, meal_id) [pk] 
  }
}
Ref: users.id < user_fav_meal.user_id
Ref: meals.id < user_fav_meal.meal_id
Ref: users.id < user_fav_cat.user_id
Ref: categories.id < user_fav_cat.cat_id
Ref: users.id < cart_items.user_id
Ref: categories.id < meals.cat_id
Ref: meals.id < cart_items.meal_id
Ref: users.id < history.user_id
Ref: meals.id < history.meal_id
Ref: meals_item.meal_id > meals.id
Ref: meals_item.item_id > items.id
Ref: option_groups.meal_id > meals.id
Ref: meals_item.group_id > option_groups.id



